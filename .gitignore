Cache/
raw/
sources/
sources_pro/

# 合并流程的中间产物，不纳入版本库
out/integrated_extra.txt
out/integrated_extra_pro.txt
out/excluded_redirect_entries.txt
out/excluded_redirect_entries_pro.txt

# Python 字节码缓存
__pycache__/
*.pyc

# 本地测试目录，不纳入版本库
test/

# 临时分析与调查目录（含第三方仓库克隆、下载的对照数据、一次性分析脚本），不纳入版本库
